# Copy to `.env` and point at your running backend.
# Expo automatically exposes EXPO_PUBLIC_* vars to the app at build time.
#
# Local dev on a physical iPhone: use your computer's LAN IP (not localhost),
#   e.g. http://192.168.1.42:8000
# Production TestFlight build: use your deployed URL, e.g. https://options-guru-api.onrender.com
EXPO_PUBLIC_API_URL=https://options-guru-api.onrender.com
